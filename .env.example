# ChequeTrack server settings. Set these as environment variables on the host
# (MonsterASP: Website > Scripting > Environment variables, then Restart application).
# Never commit real values. This file only lists the names.

# Database connection string, without the password
ConnectionStrings__ChequeDb=
# Database password, kept separate so passwords containing ; or = still work
ChequeDb__Password=

# Secrets read by the server only; they are never sent to the browser.
TELEGRAM_BOT_TOKEN=
SMTP_PASSWORD=
# Key in the daily-alert link (/api/cron/<key>); long and random, e.g. 32 hex characters
CRON_KEY=

# Security switches (normally leave unset)
# SECURITY_RLS=off              # turns off the SQL Server row-level security policy (rollback only)
# SECURITY_RATE_MULTIPLIER=20   # raises every rate limit, for automated test runs only
# AllowedHosts=equpationcheques.runasp.net   # answer only to your own host name
